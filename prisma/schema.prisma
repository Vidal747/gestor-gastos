generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT
  INVESTMENT
  OTHER
}

enum IncomeCategory {
  SALARY
  FREELANCE
  REFUND
  SALE
  EXTRA
  OTHER
}

enum ExpenseCategory {
  HOUSING
  FOOD
  TRANSPORT
  UTILITIES
  ENTERTAINMENT
  HEALTH
  EDUCATION
  SHOPPING
  SUBSCRIPTION
  TRAVEL
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  DEBIT_CARD
  CREDIT_CARD
  MOBILE_PAYMENT
  OTHER
}

enum DistributionType {
  EQUAL
  PERCENTAGE
  AMOUNT
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUALLY
  ANNUALLY
}

enum DebtStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum CreditCardStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PurchaseStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InstallmentStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

enum SavingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum OwnerRole {
  DEBTOR
  CREDITOR
}

model User {
  id                    String                     @id @default(cuid())
  email                 String                     @unique
  inviteCode            String?                    @unique
  name                  String
  passwordHash          String
  role                  UserRole                   @default(USER)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  accounts              Account[]
  incomes               Income[]
  expenses              Expense[]                  @relation("ExpenseOwner")
  expensesAsPayer       Expense[]                  @relation("ExpensePayer")
  recurringExpenses     RecurringExpense[]
  sessions              Session[]
  ownedDebts            Debt[]                     @relation("DebtOwner")
  counterpartyDebts     Debt[]                     @relation("DebtCounterparty")
  creditCards           CreditCard[]               @relation("CreditCardOwner")
  cardsHeld             CreditCard[]               @relation("CreditCardHolder")
  purchases             CreditCardPurchase[]
  savings               SavingGoal[]
  savingContributions   SavingContribution[]
  settlementsSent       Settlement[]               @relation("SettlementSender")
  settlementsReceived   Settlement[]               @relation("SettlementReceiver")
  expenseParticipants   ExpenseParticipant[]
  purchaseParticipants  PurchaseParticipant[]
  savingParticipants    SavingParticipant[]
  connectionsLow        UserConnection[]           @relation("ConnectionLow")
  connectionsHigh       UserConnection[]           @relation("ConnectionHigh")
}

model Account {
  id          String      @id @default(cuid())
  userId      String
  name        String
  type        AccountType @default(CHECKING)
  currency    String      @default("COP")
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes     Income[]
  expenses    Expense[]
  purchases   CreditCardPurchase[]

  @@index([userId])
}

model Income {
  id          String        @id @default(cuid())
  userId      String
  accountId   String?
  description String
  category    IncomeCategory
  amount      Decimal       @db.Decimal(12, 2)
  date        DateTime
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Expense {
  id            String               @id @default(cuid())
  userId        String
  accountId     String?
  description   String
  category      ExpenseCategory
  totalAmount   Decimal              @db.Decimal(12, 2)
  date          DateTime
  payerUserId   String
  paymentMethod PaymentMethod        @default(CASH)
  notes         String?
  status        String               @default("ACTIVE")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user          User                 @relation("ExpenseOwner", fields: [userId], references: [id], onDelete: Cascade)
  account       Account?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payer         User                 @relation("ExpensePayer", fields: [payerUserId], references: [id], onDelete: Cascade)
  participants  ExpenseParticipant[]

  @@index([userId, date])
  @@index([payerUserId])
}

model ExpenseParticipant {
  id               String          @id @default(cuid())
  expenseId        String
  userId           String
  distributionType DistributionType
  percentage       Decimal?        @db.Decimal(5, 2)
  amount           Decimal?        @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())

  expense          Expense         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

model RecurringExpense {
  id               String                    @id @default(cuid())
  userId           String
  description      String
  category         ExpenseCategory
  amount           Decimal                   @db.Decimal(12, 2)
  frequency        RecurrenceFrequency
  startsAt         DateTime
  nextOccurrenceAt DateTime
  notes            String?
  isActive         Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  participants     RecurringExpenseParticipant[]

  @@index([userId, nextOccurrenceAt])
}

model RecurringExpenseParticipant {
  id                 String            @id @default(cuid())
  recurringExpenseId String
  userId             String
  distributionType   DistributionType
  percentage         Decimal?          @db.Decimal(5, 2)
  amount             Decimal?          @db.Decimal(12, 2)
  createdAt          DateTime          @default(now())

  recurringExpense   RecurringExpense  @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)

  @@unique([recurringExpenseId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserConnection {
  id              String   @id @default(cuid())
  lowUserId       String
  highUserId      String
  createdByUserId String
  createdAt       DateTime @default(now())

  lowUser         User     @relation("ConnectionLow", fields: [lowUserId], references: [id], onDelete: Cascade)
  highUser        User     @relation("ConnectionHigh", fields: [highUserId], references: [id], onDelete: Cascade)

  @@unique([lowUserId, highUserId])
  @@index([lowUserId])
  @@index([highUserId])
}

model Debt {
  id                 String            @id @default(cuid())
  ownerUserId        String
  ownerRole          OwnerRole
  counterpartyUserId String?
  counterpartyName   String?
  description        String
  originalAmount     Decimal           @db.Decimal(12, 2)
  remainingAmount    Decimal           @db.Decimal(12, 2)
  status             DebtStatus        @default(PENDING)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  owner              User              @relation("DebtOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  counterparty       User?             @relation("DebtCounterparty", fields: [counterpartyUserId], references: [id], onDelete: SetNull)
  installments       DebtInstallment[]
  payments           DebtPayment[]

  @@index([ownerUserId])
  @@index([counterpartyUserId])
}

model DebtInstallment {
  id                String            @id @default(cuid())
  debtId            String
  installmentNumber Int
  amount            Decimal           @db.Decimal(12, 2)
  dueDate           DateTime
  status            InstallmentStatus @default(OPEN)
  createdAt         DateTime          @default(now())

  debt              Debt              @relation(fields: [debtId], references: [id], onDelete: Cascade)
  payments          DebtPayment[]

  @@unique([debtId, installmentNumber])
  @@index([dueDate])
}

model DebtPayment {
  id            String          @id @default(cuid())
  debtId        String
  installmentId String
  amount        Decimal         @db.Decimal(12, 2)
  paidAt        DateTime        @default(now())
  notes         String?

  debt          Debt            @relation(fields: [debtId], references: [id], onDelete: Cascade)
  installment   DebtInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([debtId, paidAt])
  @@index([installmentId])
}

model CreditCard {
  id              String          @id @default(cuid())
  userId          String
  name            String
  bank            String
  cardholderUserId String
  creditLimit     Decimal         @db.Decimal(12, 2)
  annualRate      Decimal         @db.Decimal(8, 6)
  cutoffDay       Int
  dueDay          Int
  status          CreditCardStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation("CreditCardOwner", fields: [userId], references: [id], onDelete: Cascade)
  holder          User            @relation("CreditCardHolder", fields: [cardholderUserId], references: [id], onDelete: Cascade)
  purchases       CreditCardPurchase[]

  @@index([userId, cardholderUserId])
}

model CreditCardPurchase {
  id              String                  @id @default(cuid())
  userId          String
  accountId       String?
  cardId          String
  description     String
  totalAmount     Decimal                 @db.Decimal(12, 2)
  purchaseDate    DateTime
  installments    Int                     @default(1)
  status          PurchaseStatus          @default(OPEN)
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account?                @relation(fields: [accountId], references: [id], onDelete: SetNull)
  card            CreditCard              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  participants    PurchaseParticipant[]
  installmentsData PurchaseInstallment[]

  @@index([userId, purchaseDate])
  @@index([cardId])
}

model PurchaseParticipant {
  id               String               @id @default(cuid())
  purchaseId       String
  userId           String
  distributionType DistributionType
  percentage       Decimal?             @db.Decimal(5, 2)
  amount           Decimal?             @db.Decimal(12, 2)
  createdAt        DateTime             @default(now())

  purchase         CreditCardPurchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, userId])
  @@index([userId])
}

model PurchaseInstallment {
  id                  String            @id @default(cuid())
  purchaseId          String
  installmentNumber   Int
  principalAmount     Decimal           @db.Decimal(12, 2)
  interestAmount      Decimal           @db.Decimal(12, 2)
  totalAmount         Decimal           @db.Decimal(12, 2)
  dueDate             DateTime
  remainingBalance    Decimal           @db.Decimal(12, 2)
  status              InstallmentStatus @default(OPEN)
  createdAt           DateTime          @default(now())

  purchase            CreditCardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  payments            PurchaseInstallmentPayment[]

  @@unique([purchaseId, installmentNumber])
  @@index([dueDate])
}

model PurchaseInstallmentPayment {
  id            String              @id @default(cuid())
  installmentId String
  amount        Decimal             @db.Decimal(12, 2)
  paidAt        DateTime            @default(now())
  notes         String?

  installment   PurchaseInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([installmentId, paidAt])
}

model SavingGoal {
  id             String             @id @default(cuid())
  userId         String
  name           String
  description    String?
  targetAmount   Decimal            @db.Decimal(12, 2)
  targetDate     DateTime?
  status         SavingStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions  SavingContribution[]
  participants   SavingParticipant[]

  @@index([userId])
}

model SavingParticipant {
  id           String      @id @default(cuid())
  savingGoalId String
  userId       String
  createdAt    DateTime    @default(now())

  savingGoal   SavingGoal  @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([savingGoalId, userId])
}

model SavingContribution {
  id                String      @id @default(cuid())
  savingGoalId      String
  userId            String
  amount            Decimal     @db.Decimal(12, 2)
  contributionDate  DateTime    @default(now())
  description       String?

  savingGoal        SavingGoal  @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([savingGoalId, contributionDate])
}

model Settlement {
  id              String          @id @default(cuid())
  senderUserId    String
  receiverUserId  String
  amount          Decimal         @db.Decimal(12, 2)
  description     String?
  status          SettlementStatus @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  sender          User            @relation("SettlementSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  receiver        User            @relation("SettlementReceiver", fields: [receiverUserId], references: [id], onDelete: Cascade)

  @@index([senderUserId, receiverUserId])
}
